# Copy this file to .env and replace the placeholder values.
PORT=8080
ACCESS_TOKEN=
FAST2SMS_API_KEY=
DATA_DIR=./data

# Use your app's exact origin(s) in production; comma-separate if needed.
# Keep * only for local development or when the server is intentionally public.
ALLOWED_ORIGINS=*

# Only enable if sync-config.json contains no secrets and is safe to publish.
PUBLIC_SYNC_CONFIG=false

# Leave blank for automatic Secure-cookie detection behind HTTPS proxies.
COOKIE_SECURE=
SESSION_TTL_SECONDS=86400
MAX_BODY_BYTES=15728640
